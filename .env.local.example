NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase start>
SUPABASE_SERVICE_ROLE_KEY=<service role key from supabase start>

# REQUIRED in every environment, including production hosting (Vercel project settings, etc.).
# Node — and therefore every server-side `new Date()` in this app — resolves local time from the
# TZ env var, defaulting to the host's timezone (UTC on most cloud hosts). The app's "current
# week" is derived from getMondayOfWeek(new Date()) in lib/week.ts, so on a UTC host, Vietnam-time
# Monday 00:00-06:59 is still Sunday in UTC and the guest landing page would default to the
# PREVIOUS week for those seven hours every Monday. Pinning TZ makes server date arithmetic match
# the branches' actual local time.
TZ=Asia/Ho_Chi_Minh
